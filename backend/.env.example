# Copy to backend/.env (never commit .env)
DATABASE_URL=postgresql+psycopg://saree:saree_local_pw@localhost:5433/saree
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# demo = simulated payments, no credentials needed. (razorpay is NOT implemented.)
PAYMENT_PROVIDER=demo
# Cookie "Secure" flag: true when served over HTTPS
COOKIE_SECURE=false
UPLOAD_DIR=uploads
# Optional: seed admin (used by `python -m app.cli create-admin`); no default password exists.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=choose-a-strong-password
RESERVATION_MINUTES=30
